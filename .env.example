# Local API (same-origin /api is proxied by Vite — see VITE_DEV_PROXY_TARGET)
VITE_API_BASE_URL=/api

# Where Vite proxies /api and /media during `npm run dev`
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Optional overrides (usually leave empty — Backend /uploads/config supplies S3 prefix)
# VITE_S3_PUBLIC_URL_PREFIX=
# VITE_MEDIA_BASE_URL=
